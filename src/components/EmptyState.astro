---
interface Props {
  title: string;
  message: string;
  resetLabel?: string;
}

const { title, message, resetLabel = 'Reset filters' } = Astro.props;
---

<div class="empty-state" data-filter-empty aria-live="polite" hidden>
  <span aria-hidden="true">⌖</span>
  <h2>{title}</h2>
  <p>{message}</p>
  <button type="button" class="button button--secondary" data-filter-reset>{resetLabel}</button>
</div>

<style>
  .empty-state {
    padding: 70px 20px;
    text-align: center;
  }

  .empty-state > span {
    color: var(--moss);
    font-size: 2rem;
  }

  .empty-state h2 {
    margin: 12px 0 6px;
    color: var(--ink-strong);
    font-size: 2rem;
    font-weight: 650;
    letter-spacing: -0.04em;
  }

  .empty-state p {
    margin-bottom: 20px;
    color: var(--ink-soft);
  }
</style>
