---
import type { Tool } from '../data/tools';

interface Props {
  tool: Tool;
  compact?: boolean;
}

const { tool, compact = false } = Astro.props;
const isReady = tool.status === 'Ready';
const searchText = `${tool.title} ${tool.summary} ${tool.description} ${tool.category} ${tool.format} ${tool.platform} ${tool.highlights.join(' ')}`.toLowerCase();
---

<article
  id={tool.id}
  class:list={['tool-card', compact && 'tool-card--compact']}
  data-tool-card
  data-search={searchText}
  data-category={tool.category.toLowerCase()}
>
  <div class="tool-card__top">
    <span class="tool-card__icon" aria-hidden="true">
      {
        tool.icon === 'document' && (
          <svg viewBox="0 0 24 24" fill="none">
            <path d="M6 3h8l4 4v14H6a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2Z" />
            <path d="M14 3v5h5M8 13h8M8 17h6" />
          </svg>
        )
      }
      {
        tool.icon === 'hotkey' && (
          <svg viewBox="0 0 24 24" fill="none">
            <rect x="3" y="5" width="18" height="14" rx="3" />
            <path d="M6 9h.01M9 9h.01M12 9h.01M15 9h.01M18 9h.01M7 13h2m6 0h2M9 16h6" />
          </svg>
        )
      }
      {
        tool.icon === 'map' && (
          <svg viewBox="0 0 24 24" fill="none">
            <path d="m3 6 6-3 6 3 6-3v15l-6 3-6-3-6 3V6Z" />
            <path d="M9 3v15M15 6v15" />
          </svg>
        )
      }
      {
        tool.icon === 'grid' && (
          <svg viewBox="0 0 24 24" fill="none">
            <rect x="3" y="3" width="18" height="18" rx="3" />
            <path d="M3 9h18M3 15h18M9 3v18M15 3v18" />
          </svg>
        )
      }
      {
        tool.icon === 'note' && (
          <svg viewBox="0 0 24 24" fill="none">
            <path d="M5 3h14v18H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2Z" />
            <path d="M8 8h8M8 12h8M8 16h5" />
          </svg>
        )
      }
      {
        tool.icon === 'guide' && (
          <svg viewBox="0 0 24 24" fill="none">
            <path d="M4 5.5A3.5 3.5 0 0 1 7.5 2H11v20H7.5A3.5 3.5 0 0 0 4 22V5.5Z" />
            <path d="M20 5.5A3.5 3.5 0 0 0 16.5 2H13v20h3.5A3.5 3.5 0 0 1 20 22V5.5Z" />
          </svg>
        )
      }
    </span>
    <span class:list={['tool-status', !isReady && 'tool-status--planned']}>{tool.status}</span>
  </div>

  <div class="tool-card__body">
    <div class="tool-card__meta">
      <span>{tool.category}</span>
      <span>{tool.format}</span>
    </div>
    <h3>{tool.title}</h3>
    <p>{tool.summary}</p>
    {!compact && <div class="tool-card__highlights">
      {tool.highlights.map((highlight) => <span>{highlight}</span>)}
    </div>}
    {!compact && <details class="tool-card__instructions">
      <summary>Setup notes</summary>
      <ol>
        {tool.instructions.map((instruction) => <li>{instruction}</li>)}
      </ol>
    </details>}
  </div>

  <div class="tool-card__footer">
    <span>{tool.platform} · v{tool.version} · {tool.updated}</span>
    {
      isReady ? (
        <a href={tool.href} download aria-label={`Download ${tool.title}`}>
          {tool.downloadLabel}
          <svg viewBox="0 0 20 20" fill="none" aria-hidden="true">
            <path d="M10 3v10m-4-4 4 4 4-4M4 16h12" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round" />
          </svg>
        </a>
      ) : (
        <span class="tool-card__planned">In development</span>
      )
    }
  </div>
</article>

<style>
  .tool-card {
    display: flex;
    min-height: 390px;
    padding: 25px;
    border: 1px solid var(--line);
    border-radius: var(--radius-md);
    background: var(--white);
    box-shadow: 0 3px 0 transparent;
    flex-direction: column;
    transition:
      transform 200ms var(--ease),
      box-shadow 200ms ease,
      border-color 200ms ease;
  }

  .tool-card[hidden] {
    display: none;
  }

  .tool-card:hover {
    border-color: var(--line-dark);
    box-shadow: var(--shadow-sm);
    transform: translateY(-5px);
  }

  .tool-card--compact {
    min-height: 300px;
  }

  .tool-card__top,
  .tool-card__footer {
    display: flex;
    align-items: flex-start;
    justify-content: space-between;
    gap: 18px;
  }

  .tool-card__icon {
    display: grid;
    width: 48px;
    height: 48px;
    border-radius: 14px;
    background: var(--paper-deep);
    color: var(--moss);
    place-items: center;
  }

  .tool-card__icon svg {
    width: 24px;
  }

  .tool-card__icon path,
  .tool-card__icon rect {
    stroke: currentColor;
    stroke-width: 1.6;
    stroke-linecap: round;
    stroke-linejoin: round;
  }

  .tool-status {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    padding: 6px 9px;
    border-radius: 999px;
    background: #e3edcf;
    color: #2e5b36;
    font-size: 0.62rem;
    font-weight: 800;
    letter-spacing: 0.06em;
    text-transform: uppercase;
  }

  .tool-status::before {
    width: 6px;
    height: 6px;
    border-radius: 50%;
    background: #4d8c52;
    content: '';
  }

  .tool-status--planned {
    background: #ece9df;
    color: var(--ink-soft);
  }

  .tool-status--planned::before {
    background: #9b9f96;
  }

  .tool-card__body {
    margin-top: 30px;
  }

  .tool-card__meta {
    display: flex;
    flex-wrap: wrap;
    gap: 7px;
    margin-bottom: 13px;
  }

  .tool-card__meta span {
    color: var(--moss);
    font-size: 0.67rem;
    font-weight: 800;
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }

  .tool-card__meta span + span::before {
    margin-right: 7px;
    color: var(--line-dark);
    content: '·';
  }

  .tool-card h3 {
    margin-bottom: 12px;
    color: var(--ink-strong);
    font-size: 1.45rem;
    font-weight: 650;
    letter-spacing: -0.045em;
    line-height: 1.15;
  }

  .tool-card p {
    margin-bottom: 0;
    color: var(--ink-soft);
    font-size: 0.9rem;
    line-height: 1.6;
  }

  .tool-card__highlights {
    display: flex;
    flex-wrap: wrap;
    gap: 7px;
    margin-top: 20px;
  }

  .tool-card__highlights span {
    padding: 5px 8px;
    border: 1px solid var(--line);
    border-radius: 999px;
    color: var(--ink-soft);
    font-size: 0.62rem;
    font-weight: 750;
  }

  .tool-card__instructions {
    margin-top: 20px;
    border-top: 1px solid var(--line);
    padding-top: 15px;
  }

  .tool-card__instructions summary {
    color: var(--ink-strong);
    cursor: pointer;
    font-size: 0.72rem;
    font-weight: 800;
  }

  .tool-card__instructions ol {
    margin: 12px 0 0;
    padding-left: 18px;
    color: var(--ink-soft);
    font-size: 0.73rem;
    line-height: 1.5;
  }

  .tool-card__instructions li + li {
    margin-top: 5px;
  }

  .tool-card__footer {
    align-items: center;
    margin-top: auto;
    padding-top: 22px;
    border-top: 1px solid var(--line);
  }

  .tool-card__footer > span,
  .tool-card__planned {
    color: var(--ink-soft);
    font-size: 0.63rem;
    font-weight: 700;
  }

  .tool-card__footer a {
    display: inline-flex;
    align-items: center;
    gap: 7px;
    color: var(--ink-strong);
    font-size: 0.73rem;
    font-weight: 800;
  }

  .tool-card__footer a:hover {
    color: var(--moss);
  }

  .tool-card__footer svg {
    width: 15px;
  }

  @media (max-width: 480px) {
    .tool-card__footer {
      align-items: flex-start;
      flex-direction: column;
    }
  }
</style>
