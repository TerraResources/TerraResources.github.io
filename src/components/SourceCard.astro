---
import type { Source } from '../data/sources';
import SourceLogo from './SourceLogo.astro';

interface Props {
  source: Source;
  compact?: boolean;
}

const { source, compact = false } = Astro.props;
const searchText = `${source.name} ${source.description} ${source.category} ${source.useFor} ${source.tags.join(' ')}`.toLowerCase();
---

<article
  class:list={['source-card', compact && 'source-card--compact']}
  data-source-card
  data-search={searchText}
  data-category={source.category.toLowerCase()}
>
  <div class="source-card__top">
    <div class="source-card__identity">
      <SourceLogo source={source} size={compact ? 'sm' : 'md'} />
      <span class="source-card__category">{source.category}</span>
    </div>
    <span class:list={['source-access', source.access === 'Plymouth login' && 'source-access--login']}>{source.access}</span>
  </div>
  <h3>{source.name}</h3>
  <p>{source.description}</p>
  <div class="source-card__use">
    <span>Best for</span>
    <strong>{source.useFor}</strong>
  </div>
  <div class="source-card__footer">
    <div class="source-card__tags">
      {source.tags.slice(0, compact ? 2 : 3).map((tag) => <span>{tag}</span>)}
    </div>
    <a href={source.url} target="_blank" rel="noopener noreferrer" aria-label={`Open ${source.name}`}>
      Open
      <svg viewBox="0 0 20 20" fill="none" aria-hidden="true">
        <path d="M5 15 15 5M8 5h7v7" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round" />
      </svg>
    </a>
  </div>
</article>

<style>
  .source-card {
    display: flex;
    min-height: 290px;
    padding: 23px;
    border: 1px solid var(--line);
    border-radius: var(--radius-md);
    background: var(--white);
    box-shadow: 0 3px 0 transparent;
    flex-direction: column;
    transition:
      transform 200ms var(--ease),
      box-shadow 200ms ease,
      border-color 200ms ease;
  }

  .source-card[hidden] {
    display: none;
  }

  .source-card:hover {
    border-color: var(--line-dark);
    box-shadow: var(--shadow-sm);
    transform: translateY(-4px);
  }

  .source-card--compact {
    min-height: 230px;
  }

  .source-card__top,
  .source-card__footer,
  .source-card__use,
  .source-card__tags {
    display: flex;
  }

  .source-card__top,
  .source-card__footer {
    align-items: center;
    justify-content: space-between;
    gap: 14px;
  }

  .source-card__identity {
    display: flex;
    min-width: 0;
    flex: 1 1 auto;
    align-items: center;
    gap: 11px;
  }

  .source-card__category,
  .source-access {
    color: var(--moss);
    font-size: 0.66rem;
    font-weight: 800;
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }

  .source-access {
    flex: none;
    padding: 5px 8px;
    border-radius: 999px;
    background: #e3edcf;
    color: #2e5b36;
    font-size: 0.6rem;
    letter-spacing: 0.04em;
  }

  .source-access--login {
    background: #e8e3ef;
    color: #5b4770;
  }

  .source-card h3 {
    margin: 24px 0 11px;
    color: var(--ink-strong);
    font-size: 1.3rem;
    font-weight: 650;
    letter-spacing: -0.04em;
    line-height: 1.15;
  }

  .source-card > p {
    margin-bottom: 0;
    color: var(--ink-soft);
    font-size: 0.86rem;
    line-height: 1.58;
  }

  .source-card__use {
    align-items: baseline;
    gap: 7px;
    margin-top: 18px;
  }

  .source-card__use span {
    flex: none;
    color: var(--ink-soft);
    font-size: 0.62rem;
    font-weight: 800;
    letter-spacing: 0.06em;
    text-transform: uppercase;
  }

  .source-card__use strong {
    color: var(--ink-strong);
    font-size: 0.76rem;
    font-weight: 650;
    line-height: 1.45;
  }

  .source-card__footer {
    align-items: flex-end;
    margin-top: auto;
    padding-top: 19px;
    border-top: 1px solid var(--line);
  }

  .source-card__tags {
    flex-wrap: wrap;
    gap: 5px;
  }

  .source-card__tags span {
    color: var(--ink-soft);
    font-size: 0.62rem;
    font-weight: 700;
  }

  .source-card__tags span + span::before {
    margin-right: 5px;
    color: var(--line-dark);
    content: '·';
  }

  .source-card__footer a {
    display: inline-flex;
    flex: none;
    align-items: center;
    gap: 5px;
    color: var(--ink-strong);
    font-size: 0.73rem;
    font-weight: 800;
  }

  .source-card__footer a:hover {
    color: var(--moss);
  }

  .source-card__footer svg {
    width: 15px;
  }

  @media (max-width: 480px) {
    .source-card__footer {
      align-items: flex-start;
      flex-direction: column;
    }
  }
</style>
